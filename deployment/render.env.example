KOINOXRISTA_STRIPE_ACCOUNT_ID=acct_<account-owning-the-secret-key>
KOINOXRISTA_STRIPE_COMPANY_ACCOUNTS={"<company UUID>":"acct_<same-account>"}
KOINOXRISTA_STRIPE_MODE=direct
KOINOXRISTA_PAYMENT_PUBLIC_BASE_URL=https://<your-payment-service>.onrender.com
