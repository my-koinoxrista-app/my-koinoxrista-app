# Enter individually in Render > Environment. Do not commit real values.
KOINOXRISTA_WEBHOOK_DATABASE_URL=postgresql://koinoxrista_webhook:<URL-encoded-role-password>@<Neon-host>/<database>?sslmode=require
KOINOXRISTA_STRIPE_SECRET_KEY=sk_test_<from-Stripe>
