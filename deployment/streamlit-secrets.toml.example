# Paste into Streamlit Community Cloud > App settings > Secrets.
# Keep root-level keys BEFORE [auth]. Never commit the completed file.
POSTGRES_APP_USER = "koinoxrista_app"
POSTGRES_APP_PASSWORD = "<restricted Neon app-role password>"
POSTGRES_HOST = "<your Neon hostname>"
POSTGRES_PORT = "5432"
POSTGRES_DB = "<your Neon database>"
POSTGRES_SSLMODE = "require"
KOINOXRISTA_SCOPE_KEY = "<existing scope key matching tenant_security.scope_secret>"
KOINOXRISTA_PAYMENT_PUBLIC_BASE_URL = "https://<your-payment-service>.onrender.com"
KOINOXRISTA_STRIPE_COMPANY_ACCOUNTS = '{"<company UUID>":"acct_<your Stripe account>"}'

# Copy your existing SMTP settings here as root-level keys if email is enabled.
# SMTP is optional for the payment dashboard, but required to deliver tenant emails.
KOINOXRISTA_EMAIL_SENDING_ENABLED = "false"

[auth]
redirect_uri = "https://<your-portal>.streamlit.app/oauth2callback"
cookie_secret = "<random long secret>"
client_id = "<Google OAuth client ID>"
client_secret = "<Google OAuth client secret>"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
